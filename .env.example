# Railway backend environment variables — set these in Railway's dashboard.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (use service role key on the server — never expose this in the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# Resend (email)
RESEND_API_KEY=re_...

# Frontend origin (used in CORS and welcome email link)
CLIENT_ORIGIN=https://plus4performance.com

# ─────────────────────────────────────────────────────────────────────────
# Shop (Netlify Functions) — set these in Netlify's dashboard under
# Site configuration > Environment variables, NOT here. This file is just
# a reference for `netlify dev` local testing. See SHOP-SETUP.md.
# ─────────────────────────────────────────────────────────────────────────

# Stripe (LIVE keys only — this shop has no test mode)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (email)
RESEND_API_KEY=re_...
FROM_EMAIL="Plus 4 Performance <orders@plus4performance.com>"
REPLY_TO_EMAIL=hello@plus4performance.com

# Comma-separated list of addresses that get the "new order" alert email
ORDER_ALERT_EMAILS=you@plus4performance.com,coach@plus4performance.com

# Base site URL, no trailing slash — used to build Stripe success/cancel
# URLs and absolute image URLs for Checkout + emails
SITE_URL=https://plus4performance.com

# Must be the literal string "true" to let checkout run for real customers.
# While it's anything else, checkout is refused UNLESS the shop page was
# loaded with ?preview=1, so you can run a real low-value test order first.
SHOP_LIVE=false

# ─────────────────────────────────────────────────────────────────────────
# /shop-orders admin dashboard (Netlify Functions) — set these in Netlify's
# dashboard too. Generate password hashes with:
#   cd netlify/functions && npm install
#   node ../../scripts/generate-admin-hash.js
# ─────────────────────────────────────────────────────────────────────────

# JSON map of username -> bcrypt password hash. Usernames are matched
# case-insensitively. Never put a plaintext password here.
ADMIN_USERS={"cameron":"$2b$12$examplehashreplacewithrealone...","ethan":"$2b$12$examplehashreplacewithrealone..."}

# Random secret used to sign the admin session cookie (HMAC). Generate once
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs every admin out.
SESSION_SECRET=replace-with-a-long-random-string
